PORT=4000

REPLICATE_API_TOKEN=

PYTHON_WORKER_URL=http://127.0.0.1:5000

# Nivel de logging del gateway: debug | info | warn | error (default: info).
LOG_LEVEL=info

# --- Captions API (fallback si no se guarda la key desde la UI) ---
# La key ingresada en ⚙️ Configuración de APIs se guarda en backend/.config/
# (gitignored) y tiene prioridad sobre estas variables.
CAPTIONS_AI_API_KEY=
# CAPTIONS_AI_BASE_URL=https://api.mirage.app
SUBMAGIC_API_KEY=
CAPSUBS_API_KEY=
